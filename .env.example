# Copy this file to .env for local development.
# In Render/Railway, set these as environment variables in their dashboard instead —
# do not commit a real .env file to git.

PORT=3000
NODE_ENV=production

# Render/Railway auto-provide this when you attach a PostgreSQL database.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Generate a real random secret — do NOT reuse this example value.
# Quick way to generate one: run `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-this-with-a-long-random-string
